# .env dosyasi gizli bilgiler icindir ve GitHub'a YUKLENMEZ.
# Kullanmak icin: bu dosyayi kopyalayip adini ".env" yapin.
#
# Panel ve API icin sifre istiyorsan asagidaki satira bir kelime yaz:
#   MESAJ_ANAHTARI=benim-gizli-kelime
# Bos birakirsan sifre sorulmaz (sadece bu bilgisayardan erisim zaten kapali agda).
MESAJ_ANAHTARI=

# Panelin portu (degistirmek zorunda degilsin):
PORT=5077

# 127.0.0.1 = sadece bu bilgisayar. Agdaki baska cihazlar da gorsun istersen
# 0.0.0.0 yap (guvenlik icin MESAJ_ANAHTARI da belirle).
HOST=127.0.0.1
